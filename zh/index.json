  "WinePoetry": [
    {
      "verse": "人生得意须尽欢，莫使金樽空对月",
      "source": "李白《将进酒》"
    },
    {
      "verse": "烹羊宰牛且为乐，会须一饮三百杯",
      "source": "李白《将进酒》"
    },
    {
      "verse": "古来圣贤皆寂寞，惟有饮者留其名",
      "source": "李白《将进酒》"
    },
    {
      "verse": "五花马，千金裘，呼儿将出换美酒，与尔同销万古愁",
      "source": "李白《将进酒》"
    },
    {
      "verse": "兰陵美酒郁金香，玉碗盛来琥珀光",
      "source": "李白《客中行》"
    },
    {
      "verse": "花间一壶酒，独酌无相亲。举杯邀明月，对影成三人",
      "source": "李白《月下独酌》"
    },
    {
      "verse": "抽刀断水水更流，举杯消愁愁更愁",
      "source": "李白《宣州谢朓楼饯别校书叔云》"
    },
    {
      "verse": "且乐生前一杯酒，何须身后千载名",
      "source": "李白《行路难》"
    },
    {
      "verse": "风吹柳花满店香，吴姬压酒唤客尝",
      "source": "李白《金陵酒肆留别》"
    },
    {
      "verse": "白日放歌须纵酒，青春作伴好还乡",
      "source": "杜甫《闻官军收河南河北》"
    },
    {
      "verse": "艰难苦恨繁霜鬓，潦倒新停浊酒杯",
      "source": "杜甫《登高》"
    },
    {
      "verse": "莫思身外无穷事，且尽生前有限杯",
      "source": "杜甫《绝句漫兴》"
    },
    {
      "verse": "葡萄美酒夜光杯，欲饮琵琶马上催",
      "source": "王翰《凉州词》"
    },
    {
      "verse": "醉卧沙场君莫笑，古来征战几人回",
      "source": "王翰《凉州词》"
    },
    {
      "verse": "借问酒家何处有，牧童遥指杏花村",
      "source": "杜牧《清明》"
    },
    {
      "verse": "烟笼寒水月笼沙，夜泊秦淮近酒家",
      "source": "杜牧《泊秦淮》"
    },
    {
      "verse": "对酒当歌，人生几何！譬如朝露，去日苦多",
      "source": "曹操《短歌行》"
    },
    {
      "verse": "何以解忧？唯有杜康",
      "source": "曹操《短歌行》"
    },
    {
      "verse": "绿蚁新醅酒，红泥小火炉。晚来天欲雪，能饮一杯无",
      "source": "白居易《问刘十九》"
    },
    {
      "verse": "醉不成欢惨将别，别时茫茫江浸月",
      "source": "白居易《琵琶行》"
    },
    {
      "verse": "为我引杯添酒饮，与君把箸击盘歌",
      "source": "白居易《醉赠刘二十八使君》"
    },
    {
      "verse": "酒入愁肠，化作相思泪",
      "source": "范仲淹《苏幕遮》"
    },
    {
      "verse": "明月几时有，把酒问青天",
      "source": "苏轼《水调歌头》"
    },
    {
      "verse": "人生如梦，一尊还酹江月",
      "source": "苏轼《念奴娇·赤壁怀古》"
    },
    {
      "verse": "酒酣胸胆尚开张，鬓微霜，又何妨",
      "source": "苏轼《江城子·密州出猎》"
    },
    {
      "verse": "醉里挑灯看剑，梦回吹角连营",
      "source": "辛弃疾《破阵子》"
    },
    {
      "verse": "今宵酒醒何处，杨柳岸，晓风残月",
      "source": "柳永《雨霖铃》"
    },
    {
      "verse": "拟把疏狂图一醉，对酒当歌，强乐还无味",
      "source": "柳永《蝶恋花》"
    },
    {
      "verse": "东篱把酒黄昏后，有暗香盈袖",
      "source": "李清照《醉花阴》"
    },
    {
      "verse": "三杯两盏淡酒，怎敌他、晚来风急",
      "source": "李清照《声声慢》"
    },
    {
      "verse": "劝君更尽一杯酒，西出阳关无故人",
      "source": "王维《送元二使安西》"
    },
    {
      "verse": "开轩面场圃，把酒话桑麻",
      "source": "孟浩然《过故人庄》"
    },
    {
      "verse": "醉后不知天在水，满船清梦压星河",
      "source": "唐温如《题龙阳县青草湖》"
    },
    {
      "verse": "桃李春风一杯酒，江湖夜雨十年灯",
      "source": "黄庭坚《寄黄几复》"
    },
    {
      "verse": "一曲新词酒一杯，去年天气旧亭台",
      "source": "晏殊《浣溪沙》"
    },
    {
      "verse": "为君持酒劝斜阳，且向花间留晚照",
      "source": "宋祁《玉楼春》"
    },
    {
      "verse": "酒逢知己千杯少，话不投机半句多",
      "source": "欧阳修《春日西湖寄谢法曹韵》"
    },
    {
      "verse": "今朝有酒今朝醉，明日愁来明日愁",
      "source": "罗隐《自遣》"
    },
    {
      "verse": "酒债寻常行处有，人生七十古来稀",
      "source": "杜甫《曲江》"
    },
    {
      "verse": "一生大笑能几回，斗酒相逢须醉倒",
      "source": "岑参《凉州馆中与诸判官夜集》"
    },
    {
      "verse": "我醉欲眠卿且去，明朝有意抱琴来",
      "source": "李白《山中与幽人对酌》"
    },
    {
      "verse": "且就洞庭赊月色，将船买酒白云边",
      "source": "李白《游洞庭湖》"
    },
    {
      "verse": "把酒祝东风，且共从容",
      "source": "欧阳修《浪淘沙》"
    },
    {
      "verse": "酒浓春入梦，窗破月寻人",
      "source": "毛滂《临江仙》"
    },
    {
      "verse": "醉舞下山去，明月逐人归",
      "source": "黄庭坚《水调歌头》"
    },
    {
      "verse": "酒醒还醉醉还醒，一笑人间今古",
      "source": "苏轼《渔父》"
    },
    {
      "verse": "床头一壶酒，能更几回眠",
      "source": "王绩《过酒家》"
    },
    {
      "verse": "但使主人能醉客，不知何处是他乡",
      "source": "李白《客中行》"
    },
    {
      "verse": "常记溪亭日暮，沉醉不知归路",
      "source": "李清照《如梦令》"
    },
    {
      "verse": "莫笑农家腊酒浑，丰年留客足鸡豚",
      "source": "陆游《游山西村》"
    },
    {
      "verse": "更待菊黄家酝熟，共君一醉一陶然",
      "source": "白居易《与梦得沽酒闲饮且约后期》"
    },
    {
      "verse": "且乐杯中物，谁论世上名",
      "source": "孟浩然《自洛之越》"
    },
    {
      "verse": "醉月频中圣，迷花不事君",
      "source": "李白《赠孟浩然》"
    },
    {
      "verse": "相逢意气为君饮，系马高楼垂柳边",
      "source": "王维《少年行》"
    },
    {
      "verse": "酒困路长惟欲睡，日高人渴漫思茶",
      "source": "苏轼《浣溪沙》"
    },
    {
      "verse": "人生有酒须当醉，一滴何曾到九泉",
      "source": "高翥《清明日对酒》"
    },
    {
      "verse": "对酒当歌，人生几何？诗酒趁年华",
      "source": "苏轼《望江南》"
    },
    {
      "verse": "一生须惜少年时，那能白首下书帷",
      "source": "王国维《浣溪沙》"
    },
    {
      "verse": "春日宴，绿酒一杯歌一遍",
      "source": "冯延巳《长命女》"
    },
    {
      "verse": "我欲醉眠芳草，只恐花深里，红尘不到",
      "source": "苏轼《西江月》"
    }
  ],
